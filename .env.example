APP_NAME=Text2SQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=text2sql
POSTGRES_USER=text2sql
# Local development only; change for deployment.
POSTGRES_PASSWORD=your_password
AUTH_SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-32-characters
CORS_ALLOWED_ORIGINS=*
# Optional: enables post-execution natural-language responses through Ollama.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_TIMEOUT_SECONDS=10
